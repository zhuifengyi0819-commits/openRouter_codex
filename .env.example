PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
REQUEST_LOGGING_ENABLED=false
REQUEST_TIMEOUT_MS=120000
DATA_DIR=.gateway-data
GATEWAY_API_KEYS=dev-gateway-key

# --- Codex / ChatGPT OAuth defaults ---
# "Connect Codex Team" first returns to a local relay on OAUTH_CALLBACK_PORT,
# then the relay forwards the browser back to the gateway callback page on PORT.
OAUTH_CALLBACK_PORT=1455
OAUTH_CALLBACK_PATH=/auth/callback
# Used by generic OAuth connectors served directly by the gateway callback page.
# Codex Team login does not use this; it always starts with the local relay above.
OAUTH_REDIRECT_ORIGIN=
OAUTH_CONNECT_PROVIDER_ORIGIN=https://auth.openai.com
OAUTH_CONNECT_AUTHORIZE_PATH=/oauth/authorize
OAUTH_CONNECT_TOKEN_PATH=/oauth/token
OAUTH_CONNECT_API_BASE_URL=https://chatgpt.com/backend-api
OAUTH_CONNECT_AUTHORIZE_EXTRA_JSON={"id_token_add_organizations":"true","codex_cli_simplified_flow":"true","originator":"pi"}

# These are reserved for custom OAuth connectors.
# Web "Connect Codex Team" uses the built-in Codex OAuth flow instead of these variables directly.
OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES=openid profile email offline_access

# Public model names can be mapped to upstream model names.
# Example: {"gpt-5":"gpt-5.4","claude-3-5-sonnet-latest":"claude-3-7-sonnet-latest"}
MODEL_MAP_JSON={}

# Define one or more static upstreams here, or leave empty and add them through `npm run login` / admin.
# Example:
# [
#   {
#     "id": "codex-team-a",
#     "kind": "openai",
#     "openaiMode": "codex",
#     "baseUrl": "https://chatgpt.com/backend-api",
#     "authMode": "oauth2",
#     "models": ["gpt-5.4", "gpt-5.4-mini"],
#     "oauth2": {
#       "authorizationUrl": "https://auth.openai.com/oauth/authorize",
#       "tokenUrl": "https://auth.openai.com/oauth/token",
#       "clientId": "...",
#       "clientSecret": "...",
#       "accessToken": "...",
#       "refreshToken": "...",
#       "accountId": "..."
#     }
#   },
#   {
#     "id": "openai-primary",
#     "kind": "openai",
#     "baseUrl": "https://api.openai.com",
#     "apiKey": "sk-...",
#     "models": ["gpt-4.1", "gpt-4.1-mini"],
#     "cooldownMs": 600000,
#     "timeoutMs": 120000
#   },
#   {
#     "id": "anthropic-primary",
#     "kind": "anthropic",
#     "baseUrl": "https://api.anthropic.com",
#     "apiKey": "sk-ant-...",
#     "models": ["claude-3-7-sonnet-latest"],
#     "cooldownMs": 600000,
#     "timeoutMs": 120000
#   }
# ]
UPSTREAMS_JSON=[]

# Workspaces group one or more upstreams under a stable routing id.
# If omitted, the gateway creates a single default workspace containing every upstream.
# Example:
# [
#   {
#     "id": "team-a",
#     "upstreamIds": ["codex-team-a"],
#     "modelMap": {"gpt-5":"gpt-5.4"},
#     "isDefault": true
#   },
#   {
#     "id": "team-b",
#     "upstreamIds": ["anthropic-primary"],
#     "modelMap": {"claude-main":"claude-3-7-sonnet-latest"}
#   }
# ]
WORKSPACES_JSON=[]
